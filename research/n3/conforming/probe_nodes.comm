# Report coordinates and owning elements of given (quadratic-mesh) node numbers.
from code_aster.Commands import *
import numpy as np

DEBUT()
mesh0 = LIRE_MAILLAGE(FORMAT='ASTER', UNITE=20)
mesh = CREA_MAILLAGE(MAILLAGE=mesh0, LINE_QUAD=_F(TOUT='OUI'))
X = np.array(mesh.getCoordinates().getValues()).reshape(-1, 3)
conn = mesh.getConnectivity()
print('NNODES', len(X), 'NCELLS', len(conn))
for nid in (83115, 85451):
    i = nid - 1
    owners = [c for c, nodes in enumerate(conn) if i in nodes]
    print('PROBE node', nid, 'xyz', X[i].tolist(), 'n_owner_cells', len(owners))
    for c in owners[:8]:
        nodes = conn[c]
        P = X[list(nodes)]
        print('   cell', c + 1, 'nnodes', len(nodes), 'bbox', P.min(0).round(4).tolist(), P.max(0).round(4).tolist())
FIN()
